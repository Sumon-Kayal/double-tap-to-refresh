{
  "manifest_version": 3,
  "name": "Double Tap to Refresh",
  "version": "0.1.0",
  "version_name": "0.1.1-beta",
  "description": "A floating, draggable refresh button. Double-tap it to reload the page.",
  "minimum_chrome_version": "152",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Double Tap to Refresh settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
