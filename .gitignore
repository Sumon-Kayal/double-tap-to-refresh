# Generated by scripts/build.sh, and rebuilt by every workflow. Never commit these.
/chromium/
/chrome/
/firefox/
/dist/

# web-ext, npm and signing leftovers
/web-ext-artifacts/
node_modules/
.web-extension-id

# Python bytecode (the signing tests load a script by path)
__pycache__/
*.pyc

# Written into an unpacked source archive so a rebuild gets the same file times
.source-date-epoch

# Secrets and local settings
.env
.env.*
*.pem
*.key

# Editor and system files
.DS_Store
Thumbs.db
*~
